# Eure Domain ohne https:// (für das HTTPS-Zertifikat)
DOMAIN=klarfall.de
# Kopieren nach .env und anpassen
PORT=3000
NODE_ENV=production
# Öffentliche Adresse (für Links in E-Mails)
BASE_URL=https://klarfall.de
# Ordner für Datenbank und Uploads (bei Docker: /data)
DATA_DIR=./data
# E-Mail-Adresse des Büros für Meldungen über neue Fälle
OFFICE_EMAIL=buero@klarfall.de

# E-Mail-Versand (optional – ohne diese Werte wird nur ins Log geschrieben)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Klarfall <noreply@klarfall.de>

# Einmal-Code für die Ersteinrichtung im Portal (/portal/): damit legt ihr den ersten Büro-Zugang an.
# Langen Zufallswert eintragen. Nach der Einrichtung ist er wirkungslos und kann gelöscht werden.
SETUP_CODE=

# Name eurer Firma (erscheint in der Vollmacht und in Nachrichten)
COMPANY_NAME=Quickpay
# Ländervorwahl für Nummern ohne +, z. B. 0151… → +49151…
DEFAULT_COUNTRY_CODE=+49

# --- E-Mail über Brevo (statt SMTP) ---
# Nötig, wo SMTP gesperrt ist (Railway Trial/Hobby). Kostenlos bis 300 Mails/Tag: brevo.com
# MAIL_FROM muss in Brevo als Absender bestätigt sein, z. B. Quickpay <eure@adresse.de>
BREVO_API_KEY=

# --- SMS & WhatsApp über Twilio (optional) ---
# Ohne diese Werte gehen Benachrichtigungen nur per E-Mail.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Absender für SMS, z. B. +4930123456 oder ein Alphanumerischer Name wie Klarfall
TWILIO_SMS_FROM=
# WhatsApp-Absender, z. B. whatsapp:+4930123456 (in Twilio freigeschaltet)
TWILIO_WHATSAPP_FROM=
# WhatsApp-Vorlage (Content SID, beginnt mit HX). Nötig für Nachrichten außerhalb des 24-Stunden-Fensters.
# Die Vorlage braucht eine Variable {{1}} für den Text.
TWILIO_WA_TEMPLATE_SID=

# --- Video-Gutachten (optional) ---
# jitsi | daily | whereby   (leer = Videoknopf ausgeblendet)
VIDEO_PROVIDER=jitsi
# Jitsi: eigener Server oder meet.jit.si / 8x8.vc
JITSI_DOMAIN=meet.jit.si
# Nur bei eigenem Jitsi-Server mit Token-Anmeldung (JWT):
JITSI_APP_ID=
JITSI_APP_SECRET=
# Daily.co
DAILY_API_KEY=
# Whereby Embedded
WHEREBY_API_KEY=

# --- KI-Schadenerkennung (optional) ---
# API-Schlüssel von console.anthropic.com. Ohne Schlüssel ist die KI aus.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
