# Kopieren nach .env und anpassen
PORT=3000
NODE_ENV=production
# Öffentliche Adresse (für Links in E-Mails)
BASE_URL=https://klarfall.de
# Ordner für Datenbank und Uploads (bei Docker: /data)
DATA_DIR=./data
# E-Mail-Adresse des Büros für Meldungen über neue Fälle
OFFICE_EMAIL=buero@klarfall.de

# E-Mail-Versand (optional – ohne diese Werte wird nur ins Log geschrieben)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Klarfall <noreply@klarfall.de>
